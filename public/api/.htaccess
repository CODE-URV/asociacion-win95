Options -Indexes

RewriteEngine On

# /api/get-calendar -> /api/get-calendar.php (mismas URLs que tenía Vercel)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([A-Za-z0-9_-]+)$ $1.php [L,QSA]

# El archivo de funciones comunes no se sirve
<Files "_lib.php">
    Require all denied
</Files>
